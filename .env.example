# Backend Environment Variables
JWT_SECRET=your_super_secure_jwt_secret_key_min_32_characters
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority&appName=ClusterName

# Frontend Environment Variables (Vite)
VITE_API_URL=https://your-deployed-domain.vercel.app/api
# For local development, leave this blank and vite.config.js will use /api proxy

# Optional: Frontend URL for CORS
FRONTEND_URL=https://your-deployed-domain.vercel.app
